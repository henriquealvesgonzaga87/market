# Copy this file to .env and fill in your local secrets.
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_USER=app_user
MYSQL_PASSWORD=changeme_db
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=changeme_rabbit
DATABASE_DRIVER=mysql+aiomysql
DATABASE_PORT=3306
ORDERS_DATABASE_HOST=orders_db
ORDERS_DATABASE_NAME=orders_db
PAYMENTS_DATABASE_HOST=payments_db
PAYMENTS_DATABASE_NAME=payments_db
USERS_DATABASE_HOST=users_db
USERS_DATABASE_NAME=users_db
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_SECRET_KEY=replace_with_another_long_random_secret
REFRESH_TOKEN_EXPIRE_DAYS=7
